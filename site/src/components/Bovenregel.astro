---
/**
 * Kleine aanduiding boven een kop: een streepje gevolgd door een woord in
 * kapitalen. Vervangt het pilletje met bolletje dat op vrijwel elke
 * sjabloonsite staat.
 */
interface Props { tekst: string }
const { tekst } = Astro.props;
---
<p class="flex items-start gap-2.5 text-[0.6875rem] font-semibold uppercase tracking-[0.1em] text-accent sm:text-xs">
  <span aria-hidden="true" class="mt-[0.5em] h-px w-6 shrink-0 bg-accent"></span>
  {tekst}
</p>
