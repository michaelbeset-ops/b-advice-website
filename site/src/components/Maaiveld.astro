---
/**
 * Het eigen detail van deze site: een doorsnede van het maaiveld met twee
 * ondergrondse inzamelvoorzieningen, getekend zoals op een inrichtings-
 * tekening. Het is letterlijk wat B-Advice doet, en het komt uit geen enkel
 * sjabloon.
 *
 * De maaiveldlijn is een CSS-lijn: altijd haarscherp en over de volle breedte,
 * ongeacht de schermmaat. De putten zitten in een SVG op vaste maat, zodat ze
 * op een smal scherm niet uitgerekt worden maar netjes buiten beeld doorlopen.
 * De tekening lijnt links uit met de tekstkolom.
 */
const MV = 74; // hoogte van de maaiveldlijn binnen de tekening
---

<div class="relative h-[200px] overflow-hidden" aria-hidden="true">
  <!-- Maaiveld: loopt van rand tot rand, ook buiten het kader. -->
  <div class="absolute inset-x-0 h-px bg-line-strong" style={`top:${MV}px`}></div>

  <div class="h-full px-gutter">
    <div class="relative mx-auto h-full w-full max-w-kader">
      <svg
        class="absolute left-0 top-0 h-[200px] w-[680px] text-line-strong"
        viewBox="0 0 680 200"
        fill="none"
        preserveAspectRatio="xMinYMin meet"
      >
        <g stroke="currentColor" stroke-width="1">
          <!-- Voorziening 1: inworpzuil boven het maaiveld, container eronder. -->
          <rect x="70" y="26" width="44" height={MV - 26} />
          <line x1="79" y1="39" x2="105" y2="39" />
          <rect x="46" y={MV} width="92" height="82" fill="currentColor" fill-opacity="0.04" />
          <line x1="46" y1={MV + 14} x2="138" y2={MV + 14} />
          <!-- Maatstreepjes op het maaiveld, waar de put de bestrating raakt. -->
          <line x1="46" y1={MV - 5} x2="46" y2={MV + 5} />
          <line x1="138" y1={MV - 5} x2="138" y2={MV + 5} />

          <!-- Voorziening 2, iets dieper: containers verschillen per fractie. -->
          <rect x="262" y="36" width="44" height={MV - 36} />
          <line x1="271" y1="48" x2="297" y2="48" />
          <rect x="238" y={MV} width="92" height="100" fill="currentColor" fill-opacity="0.04" />
          <line x1="238" y1={MV + 14} x2="330" y2={MV + 14} />
          <line x1="238" y1={MV - 5} x2="238" y2={MV + 5} />
          <line x1="330" y1={MV - 5} x2="330" y2={MV + 5} />

          <!-- Maatlijn voor de vrije ruimte tussen beide putten. -->
          <line x1="138" y1="116" x2="238" y2="116" stroke-dasharray="2 3" />
          <line x1="138" y1="109" x2="138" y2="123" />
          <line x1="238" y1="109" x2="238" y2="123" />
        </g>
      </svg>
    </div>
  </div>
</div>
