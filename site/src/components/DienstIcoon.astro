---
/**
 * Zelfgetekende pictogrammen, één per dienst. Geen iconenpakket voor vijf
 * vormen, en zo kan elk teken ook echt over de dienst gaan: een put in de
 * grond, een meetlint, een leidingtracé, een tekening, een gesprek.
 */
interface Props {
  soort: "put" | "meten" | "leidingen" | "tekening" | "advies";
  klasse?: string;
}
const { soort, klasse = "" } = Astro.props;
---

<span
  class:list={[
    "flex h-12 w-12 items-center justify-center rounded-base bg-accent/10 text-accent",
    klasse,
  ]}
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-6 w-6"
    aria-hidden="true"
  >
    {soort === "put" && (
      <>
        <path d="M2 9h20" />
        <rect x="10" y="4" width="4" height="5" />
        <path d="M6 9v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V9" />
      </>
    )}
    {soort === "meten" && (
      <>
        <path d="M3 17h18" />
        <path d="M6 17v-3M10 17v-5M14 17v-3M18 17v-5" />
        <circle cx="12" cy="5" r="2" />
      </>
    )}
    {soort === "leidingen" && (
      <>
        <path d="M3 8h7a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h7" />
        <path d="M3 16h4" />
        <circle cx="19" cy="8" r="1.6" />
      </>
    )}
    {soort === "tekening" && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="1" />
        <path d="M3 9h18M9 9v11" />
        <path d="M13 13h4" />
      </>
    )}
    {soort === "advies" && (
      <>
        <path d="M21 12a8 8 0 1 1-3.2-6.4" />
        <path d="M9 11.5l2.5 2.5L21 5" />
      </>
    )}
  </svg>
</span>
