---
/**
 * Zichtbaar kruimelpad plus het bijbehorende BreadcrumbList-blok, uit dezelfde
 * bron. Zo kunnen wat de bezoeker ziet en wat Google leest niet uit elkaar
 * lopen.
 */
interface Props {
  /** Van Home tot en met de huidige pagina. */
  spoor: readonly { label: string; url: string }[];
}
const { spoor } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: spoor.map((stap, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: stap.label,
    item: `https://b-advice.info${stap.url}`,
  })),
};
---

<nav aria-label="Kruimelpad" class="pt-7 text-sm text-ink-4">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {spoor.map((stap, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class="text-ink-4">/</span>}
        {i === spoor.length - 1 ? (
          <span aria-current="page" class="font-semibold text-ink-2">{stap.label}</span>
        ) : (
          <a href={stap.url} class="underline decoration-line-strong underline-offset-2 transition-colors hover:text-accent hover:decoration-current">
            {stap.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
