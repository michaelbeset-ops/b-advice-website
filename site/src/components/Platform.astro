---
import Kader from "./Kader.astro";
import { homeSecties } from "../data/site";

const { platform } = homeSecties;
---

<!-- Donkere band. Hier geldt het logogroen: op dit vlak haalt het 6,3:1,
     terwijl het accentgroen juist te donker zou zijn. -->
<section class="bg-ink text-op-donker">
  <Kader klasse="py-20 lg:py-28">
    <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.1em] text-op-donker">
          <span aria-hidden="true" class="h-px w-6 bg-merk"></span>
          {platform.bovenregel}
        </p>
        <h2 class="mt-6 max-w-[16ch] text-2xl font-extrabold text-wit">{platform.kop}</h2>
        <p class="mt-5 max-w-[46ch] text-base text-op-donker-sterk">{platform.lead}</p>
      </div>

      <ul class="lg:col-span-5 lg:col-start-8 lg:mt-14">
        {platform.kenmerken.map((kenmerk, i) => (
          <li class:list={["py-3.5 text-base text-op-donker-sterk", i > 0 && "border-t border-wit/10"]}>
            {kenmerk}
          </li>
        ))}
      </ul>

      <div class="flex flex-col gap-3 sm:flex-row lg:col-span-12">
        {platform.acties.map((actie, i) => (
          <a
            href={actie.url}
            target={"extern" in actie && actie.extern ? "_blank" : undefined}
            rel={"extern" in actie && actie.extern ? "noopener" : undefined}
            class:list={[
              "rounded-base px-7 py-4 text-center text-base transition-colors sm:py-3.5",
              i === 0
                ? "bg-merk font-semibold text-ink hover:bg-wit"
                : "border border-wit/25 font-medium text-wit hover:border-wit/60",
            ]}
          >
            {actie.label}
          </a>
        ))}
      </div>
    </div>
  </Kader>
</section>
