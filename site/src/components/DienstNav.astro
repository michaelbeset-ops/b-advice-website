---
import { navigatie } from "../data/site";

interface Props { huidig: string }
const { huidig } = Astro.props;
---
<nav aria-label="Alle diensten">
  <h2 class="text-xs font-bold uppercase tracking-[0.1em] text-ink-4">Alle diensten</h2>
  <ul class="mt-4 border-t border-line">
    {navigatie.diensten.map((d) => {
      const actief = d.url === huidig;
      return (
        <li class="border-b border-line">
          <a
            href={d.url}
            aria-current={actief ? "page" : undefined}
            class:list={[
              "block py-3 text-sm transition-colors",
              actief ? "font-semibold text-accent" : "text-ink-3 hover:text-ink",
            ]}
          >
            {d.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
