---
import Kader from "./Kader.astro";
import Kop from "./Kop.astro";
import { home, hoofdactie } from "../data/site";

const { hero } = home;
---

<!-- Zelfde opzet als de huidige site: tekst links, beeld rechts, cijfers
     eronder. De verhouding 52/48 komt daar ook vandaan. -->
<section id="inhoud" class="border-b border-line bg-paper">
  <Kader klasse="pt-14 pb-16 lg:pt-20 lg:pb-20">
    <div class="grid items-center gap-x-14 gap-y-12 lg:grid-cols-[52fr_48fr]">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.08em] text-accent">
          {hero.bovenregel}
        </p>

        <Kop
          als="h1"
          tekst={hero.kop}
          accent={hero.kopAccent}
          klasse="mt-6 max-w-[15ch] text-display font-extrabold text-ink"
        />

        <p class="mt-6 max-w-[38ch] text-xl font-medium text-ink-2">
          {hero.lead}
        </p>

        <div class="mt-6 max-w-[54ch] space-y-4">
          {hero.alineas.map((alinea) => <p class="text-base text-ink-3">{alinea}</p>)}
        </div>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={hoofdactie.url}
            class="rounded-base bg-accent px-7 py-4 text-center text-base font-semibold text-wit transition-colors hover:bg-accent-deep sm:py-3.5"
          >
            {hoofdactie.label}
          </a>
          <a
            href={hero.tweedeActie.url}
            class="rounded-base border border-line-strong px-7 py-4 text-center text-base font-medium text-ink-2 transition-colors hover:border-ink-3 sm:py-3.5"
          >
            {hero.tweedeActie.label}
          </a>
        </div>

        <!-- Cijfers onder de tekst, gescheiden door verticale lijnen, net als nu. -->
        <dl class="mt-12 grid gap-x-6 sm:grid-cols-3">
          {
            hero.feiten.map((feit, i) => (
              <div
                class:list={[
                  i > 0 && "border-t border-line pt-4 sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0",
                  i > 0 && "mt-4 sm:mt-0",
                ]}
              >
                <dd class="font-display text-xl font-extrabold leading-tight tracking-tight text-ink lg:text-2xl">
                  {feit.waarde}
                </dd>
                <dt class="mt-1.5 text-sm leading-snug text-ink-4">{feit.label}</dt>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="lg:justify-self-end">
        <img
          src="/assets/dashboard.webp"
          alt="Het B-Organized dashboard met een containeroverzicht per gemeente"
          width="1400"
          height="1050"
          fetchpriority="high"
          decoding="async"
          class="w-full rounded-kaart border border-line"
        />
      </div>
    </div>
  </Kader>
</section>
