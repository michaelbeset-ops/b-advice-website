---
import Bovenregel from "./Bovenregel.astro";
import Maaiveld from "./Maaiveld.astro";
import { home, hoofdactie } from "../data/site";

const { hero } = home;
---

<section id="inhoud" class="px-gutter pt-16 lg:pt-28">
  <!-- Asymmetrisch raster: de tekst staat op zeven van de twaalf kolommen en
       de feiten op drie, met een lege kolom ertussen en rechtsboven bewust
       niets. Dat lege vlak is het verschil met een gecentreerde hero. -->
  <div class="grid gap-x-8 gap-y-14 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <Bovenregel tekst={hero.bovenregel} />

      <h1 class="mt-6 max-w-[16ch] text-display font-extrabold text-ink">
        {hero.kop}
      </h1>

      <p class="mt-7 max-w-[34ch] text-xl font-medium text-ink-2">
        {hero.lead}
      </p>

      <div class="mt-7 max-w-[58ch] space-y-4">
        {hero.alineas.map((alinea) => (
          <p class="text-base text-ink-3">{alinea}</p>
        ))}
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={hoofdactie.url}
          class="rounded-base bg-accent px-7 py-4 text-center text-base font-semibold text-wit transition-colors hover:bg-accent-deep sm:py-3.5"
        >
          {hoofdactie.label}
        </a>
        <a
          href={hero.tweedeActie.url}
          class="rounded-base border border-line-strong px-7 py-4 text-center text-base font-medium text-ink-2 transition-colors hover:border-ink-3 sm:py-3.5"
        >
          {hero.tweedeActie.label}
        </a>
      </div>
    </div>

    <!-- De feiten beginnen op de hoogte van de lopende tekst, niet bij de kop.
         Daardoor blijft de rechterbovenhoek leeg. -->
    <dl class="lg:col-span-3 lg:col-start-10 lg:mt-[13.5rem]">
      {hero.feiten.map((feit, i) => (
        <div class:list={["py-4", i > 0 && "border-t border-line"]}>
          <dt class="text-sm text-ink-4">{feit.label}</dt>
          <dd class="mt-1 font-display text-xl font-bold tracking-tight text-ink">
            {feit.waarde}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<div class="mt-20 lg:mt-28">
  <Maaiveld />
</div>
