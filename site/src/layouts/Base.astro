---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Bedrijfsgegevens from "../components/Bedrijfsgegevens.astro";
import { a11y, bedrijf } from "../data/site";

interface Props {
  titel: string;
  omschrijving: string;
  /** Zoekmachines weren van deze pagina, bijvoorbeeld op de 404. */
  nietIndexeren?: boolean;
  /** "article" op een nieuwsartikel, anders "website". */
  soort?: "website" | "article";
  /** Publicatiedatum van een artikel, als ISO-datum. */
  gepubliceerd?: string;
}
const {
  titel,
  omschrijving,
  nietIndexeren = false,
  soort = "website",
  gepubliceerd,
} = Astro.props;
const pad = Astro.url.pathname;
const canoniek = new URL(pad, Astro.site).href;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={omschrijving} />
    <link rel="canonical" href={canoniek} />
    {/* Een foutpagina hoort niet in de zoekresultaten. */}
    {nietIndexeren && <meta name="robots" content="noindex, follow" />}

    <!-- De twee lettertypebestanden staan op het kritieke pad van de eerste
         schermvulling, dus die halen we alvast op. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/schibsted-grotesk-latin-wght-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/public-sans-latin-wght-normal.woff2" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" href="/assets/favicon.png" />

    <meta property="og:type" content={soort} />
    <meta property="og:site_name" content={bedrijf.naam} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={omschrijving} />
    <meta property="og:url" content={canoniek} />
    <meta property="og:image" content={new URL("/assets/og-image.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${bedrijf.naam}, specialist in ondergrondse afvalcontainers`} />
    {gepubliceerd && <meta property="article:published_time" content={gepubliceerd} />}
    {gepubliceerd && <meta property="article:publisher" content="https://b-advice.info/" />}
    <meta name="twitter:card" content="summary_large_image" />

    <Bedrijfsgegevens />
  </head>
  <body>
    <a href="#inhoud" class="skip-link">{a11y.skipLink}</a>
    <Header pad={pad} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
