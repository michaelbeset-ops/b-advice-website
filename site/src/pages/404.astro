---
import Base from "../layouts/Base.astro";
import Kader from "../components/Kader.astro";
import { nietGevonden } from "../data/site";
---

<Base
  titel={nietGevonden.meta.titel}
  omschrijving={nietGevonden.meta.omschrijving}
  nietIndexeren
>
  <Kader als="section" id="inhoud" klasse="pb-28 pt-20 lg:pt-24">
    <p class="font-display text-sm font-bold uppercase tracking-[0.1em] text-accent">404</p>
    <h1 class="mt-5 max-w-[16ch] text-3xl font-extrabold text-ink">{nietGevonden.h1}</h1>
    <p class="mt-5 max-w-[50ch] text-base text-ink-3">{nietGevonden.tekst}</p>
    <ul class="mt-8 space-y-3">
      {
        nietGevonden.suggesties.map((s) => (
          <li>
            <a
              href={s.url}
              class="text-base font-medium text-accent underline decoration-accent/30 underline-offset-2 transition-colors hover:decoration-current"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </Kader>
</Base>
