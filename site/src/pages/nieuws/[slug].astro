---
import Base from "../../layouts/Base.astro";
import Kader from "../../components/Kader.astro";
import Kruimels from "../../components/Kruimels.astro";
import CtaBand from "../../components/CtaBand.astro";
import { artikelen } from "../../data/nieuws";
import type { Artikel } from "../../data/nieuws";
import { bedrijf, hoofdactie } from "../../data/site";
import { datumNL } from "../../lib/datum";
import { leestijd, inhoudsopgave } from "../../lib/artikel";

export function getStaticPaths() {
  return artikelen.map((artikel, i) => ({
    params: { slug: artikel.slug },
    // Onderaan het artikel staan de drie eerstvolgende artikelen. Die lijst
    // wordt hier al bepaald, zodat de pagina zelf niets hoeft te rekenen.
    props: {
      artikel,
      verder: [...artikelen.slice(i + 1), ...artikelen.slice(0, i)].slice(0, 3),
    },
  }));
}

interface Props {
  artikel: Artikel;
  verder: Artikel[];
}
const { artikel, verder } = Astro.props;
const url = `https://b-advice.info/nieuws/${artikel.slug}/`;

const vragen = artikel.blokken.flatMap((b) => (b.type === "faq" ? b.items : []));

// Inhoudsopgave en leestijd komen uit het artikel zelf, zodat een nieuw
// artikel er niets extra's voor hoeft aan te leveren.
const koppen = inhoudsopgave(artikel);
const minuten = leestijd(artikel);

// De id's worden tijdens het renderen op volgorde aan de h2's gehangen.
let kopTeller = 0;

const schema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    headline: artikel.h1,
    description: artikel.lead,
    datePublished: artikel.datum,
    // Zonder dateModified gaat Google uit van de publicatiedatum. Zolang een
    // artikel niet is herzien zijn die gelijk.
    dateModified: artikel.datum,
    // Google vraagt om een afbeelding bij een artikel. Er is nog geen beeld
    // per artikel, dus staat hier het algemene deelplaatje.
    image: ["https://b-advice.info/assets/og-image.png"],
    articleSection: artikel.categorie,
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    isPartOf: { "@id": "https://b-advice.info/nieuws/#blog" },
    author: { "@id": "https://b-advice.info/#organisatie" },
    publisher: { "@id": "https://b-advice.info/#organisatie" },
    inLanguage: "nl-NL",
    wordCount: minuten * 200,
    timeRequired: `PT${minuten}M`,
  },
];
if (vragen.length) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: vragen.map((v) => ({
      "@type": "Question",
      name: v.vraag,
      // Het antwoord bevat soms een link; schema.org wil hier platte tekst.
      acceptedAnswer: { "@type": "Answer", text: v.antwoord.replace(/<[^>]+>/g, "") },
    })),
  });
}
---

<Base
  titel={`${artikel.meta.titel} | ${bedrijf.naam}`}
  omschrijving={artikel.meta.omschrijving}
  soort="article"
  gepubliceerd={artikel.datum}
>
  <Kader>
    <Kruimels
      spoor={[
        { label: "Home", url: "/" },
        { label: "Nieuws", url: "/nieuws/" },
        { label: artikel.h1, url: `/nieuws/${artikel.slug}/` },
      ]}
    />
  </Kader>

  <Kader als="header" id="inhoud" klasse="pt-8 lg:pt-12">
    <div class="border-b border-line-strong pb-9 lg:pb-11">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold uppercase tracking-[0.08em] text-accent">
        {artikel.categorie}
        <span aria-hidden="true" class="h-px w-4 bg-line-strong"></span>
        <span class="font-normal normal-case tracking-normal text-ink-4">
          <time datetime={artikel.datum}>{datumNL(artikel.datum)}</time>
        </span>
        <span aria-hidden="true" class="h-px w-4 bg-line-strong"></span>
        <span class="font-normal normal-case tracking-normal text-ink-4">
          {minuten} minuten lezen
        </span>
      </p>

      <h1 class="mt-5 max-w-[20ch] text-3xl font-extrabold text-ink sm:mt-6 lg:text-display">{artikel.h1}</h1>

      <p class="mt-5 max-w-[54ch] text-lg font-medium leading-snug text-ink-2 sm:mt-6 sm:text-xl">
        {artikel.lead}
      </p>
    </div>
  </Kader>

  <Kader als="article" klasse="pb-16 pt-8 lg:pb-24 lg:pt-10">
    {/* Tekst op zeven kolommen, inhoudsopgave op vier. De regellengte blijft
        onder de 70 tekens en de rechterhelft van een breed scherm staat niet
        meer leeg. */}
    <div class="grid gap-x-16 lg:grid-cols-12">
      <aside class="lg:col-span-4 lg:order-2 lg:col-start-9">
        {/* Twee uitvoeringen van dezelfde lijst. Een dichtgeklapte <details>
            kan niet met CSS opengezet worden op een breed scherm, dus staat
            hier voor de telefoon een inklapbare versie en voor het brede
            scherm een vaste lijst die meeloopt in beeld. */}
        <details class="group/inhoud mb-8 border-y border-line lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 text-xs font-semibold uppercase tracking-[0.1em] text-accent [&::-webkit-details-marker]:hidden">
            In dit artikel
            <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0" aria-hidden="true">
              <line x1="1" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <line
                x1="8" y1="1" x2="8" y2="15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                class="origin-center transition-transform group-open/inhoud:rotate-90 group-open/inhoud:opacity-0"
              />
            </svg>
          </summary>
          <ol class="pb-4">
            {koppen.map((kop, i) => (
              <li class="flex gap-3 py-1.5">
                <span aria-hidden="true" class="mt-0.5 font-display text-xs font-bold text-ink-4">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <a href={`#${kop.id}`} class="text-sm leading-snug text-ink-3">
                  {kop.tekst}
                </a>
              </li>
            ))}
          </ol>
        </details>

        <nav
          aria-label="Inhoud van dit artikel"
          class="hidden lg:sticky lg:top-[calc(var(--spacing-header)+2rem)] lg:block lg:border-t-2 lg:border-accent/25 lg:pt-5"
        >
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">In dit artikel</p>
          <ol class="mt-4">
            {koppen.map((kop, i) => (
              <li class="flex gap-3 py-1.5">
                <span aria-hidden="true" class="mt-0.5 font-display text-xs font-bold text-ink-4">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <a
                  href={`#${kop.id}`}
                  class="text-sm leading-snug text-ink-3 transition-colors hover:text-accent"
                >
                  {kop.tekst}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      <div class="lg:col-span-7 lg:order-1">
      {
        artikel.blokken.map((blok, i) => {
          switch (blok.type) {
            case "h2": {
              const id = koppen[kopTeller++]?.id;
              return (
                <h2 id={id} class="mt-10 scroll-mt-24 border-t border-line pt-6 sm:mt-14 sm:scroll-mt-28 sm:pt-7 text-xl font-extrabold text-ink first:mt-0 first:border-0 first:pt-0">
                  {blok.tekst}
                </h2>
              );
            }
            case "h3":
              return (
                <h3 class="mt-7 font-display text-[1.0625rem] sm:mt-9 font-bold tracking-tight text-ink">
                  {blok.tekst}
                </h3>
              );
            case "streep":
              // De tussenkoppen brengen al genoeg rust; een extra lijn maakt
              // het alleen rommelig.
              return null;
            case "lijst":
              return (
                <ul class="mt-5 space-y-2.5">
                  {blok.items.map((item) => (
                    <li class="flex gap-3.5 text-base leading-[1.65] text-ink-3 sm:text-[1.0625rem] sm:leading-[1.7]">
                      <span aria-hidden="true" class="mt-[0.8em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent/40" />
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              );
            case "stappen":
              return (
                <ol class="mt-5 space-y-5 sm:mt-6 sm:space-y-6">
                  {blok.items.map((stap, i) => (
                    <li class="border-l-2 border-accent/25 pl-5">
                      <span class="font-display text-sm font-bold text-accent">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <h3 class="mt-1 font-display text-base font-bold tracking-tight text-ink">
                        {stap.titel}
                      </h3>
                      <p class="mt-1.5 text-base leading-[1.65] text-ink-3 sm:text-[1.0625rem] sm:leading-[1.7]" set:html={stap.tekst} />
                    </li>
                  ))}
                </ol>
              );
            case "citaat":
              return (
                /* Citaat zonder kader: groot gezet, met een groen streepje
                   ervoor. Het onderbreekt de tekst zonder er een doos van te
                   maken. */
                <blockquote class="my-8 border-l-2 border-accent py-1 pl-5 sm:my-10 sm:pl-6">
                  <p
                    class="max-w-[38ch] font-display text-xl font-bold leading-snug tracking-tight text-ink"
                    set:html={blok.tekst}
                  />
                </blockquote>
              );
            case "kader":
              return (
                <aside class="my-8 border-l-2 border-accent/40 bg-paper-2 px-5 py-6 sm:my-10 sm:px-7 sm:py-7">
                  <h3 class="font-display text-base font-bold tracking-tight text-ink">
                    {blok.titel}
                  </h3>
                  {blok.inhoud.map((deel) =>
                    deel.type === "p" ? (
                      <p class="mt-3 text-base leading-[1.65] text-ink-3 sm:text-[1.0625rem] sm:leading-[1.7]" set:html={deel.tekst} />
                    ) : (
                      <ul class="mt-3 space-y-2">
                        {deel.items.map((item) => (
                          <li class="flex gap-3 text-base text-ink-3">
                            <span aria-hidden="true" class="mt-[0.7em] h-px w-3 shrink-0 bg-line-strong" />
                            <span set:html={item} />
                          </li>
                        ))}
                      </ul>
                    )
                  )}
                </aside>
              );
            case "let-op":
              return (
                /* Let op krijgt een eigen gezicht: een uitroepteken en een
                   warme rand, zodat het niet op het informatiekader lijkt. */
                <aside class="my-8 flex gap-4 border border-[#c8a24a]/40 bg-[#c8a24a]/[0.07] px-5 py-5 sm:my-10 sm:px-6 sm:py-6">
                  <span
                    aria-hidden="true"
                    class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#8a6a14] font-display text-sm font-bold text-wit"
                  >
                    !
                  </span>
                  <span>
                    <span class="block text-xs font-semibold uppercase tracking-[0.08em] text-[#6b520f]">
                      {blok.label}
                    </span>
                    <span class="mt-2 block text-base leading-[1.65] text-ink-3 sm:text-[1.0625rem] sm:leading-[1.7]" set:html={blok.tekst} />
                  </span>
                </aside>
              );
            case "cijfers":
              return (
                <aside class="my-8 bg-ink px-5 py-7 sm:my-10 sm:px-7 sm:py-8">
                  {blok.label && (
                    <p class="text-xs font-semibold uppercase tracking-[0.08em] text-merk">
                      {blok.label}
                    </p>
                  )}
                  {blok.titel && (
                    <p class="mt-3 font-display text-lg font-bold tracking-tight text-wit">
                      {blok.titel}
                    </p>
                  )}
                  {blok.sub && <p class="mt-1.5 text-sm text-op-donker-sterk">{blok.sub}</p>}
                  <dl class="mt-6 grid gap-x-8 gap-y-6 min-[26rem]:grid-cols-2 xl:grid-cols-3">
                    {blok.items.map((cijfer) => (
                      <div>
                        <dd class="font-display text-2xl font-extrabold tracking-tight text-merk [overflow-wrap:anywhere]">
                          {cijfer.waarde}
                        </dd>
                        <dt class="mt-2 text-sm leading-snug text-op-donker-sterk [hyphens:auto]">{cijfer.label}</dt>
                      </div>
                    ))}
                  </dl>
                  {blok.bron && (
                    <p class="mt-6 border-t border-wit/15 pt-4 text-xs text-op-donker">{blok.bron}</p>
                  )}
                </aside>
              );
            case "faq":
              return (
                <section class="mt-12">
                  <div class="border-t border-line-strong">
                    {blok.items.map((v) => (
                      <details class="group border-b border-line">
                        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-display text-base font-bold text-ink transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
                          {v.vraag}
                          <svg viewBox="0 0 16 16" class="mt-1 h-4 w-4 shrink-0 text-accent" aria-hidden="true">
                            <line x1="1" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                            <line x1="8" y1="1" x2="8" y2="15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                                  class="origin-center transition-transform group-open:rotate-90 group-open:opacity-0" />
                          </svg>
                        </summary>
                        <p class="pb-5 text-base text-ink-3" set:html={v.antwoord} />
                      </details>
                    ))}
                  </div>
                </section>
              );
            case "video":
              return (
                /* De video laadt pas als hij in beeld komt; YouTube haalt
                   anders bij elk bezoek een half megabyte binnen. */
                <div class="my-9 aspect-video w-full overflow-hidden rounded-kaart border border-line">
                  <iframe
                    src={blok.src}
                    title={blok.titel}
                    loading="lazy"
                    class="h-full w-full"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  />
                </div>
              );
            case "bron":
              return (
                <p class="mt-8 border-t border-line pt-4 text-sm text-ink-4" set:html={blok.tekst} />
              );
            case "cta":
              return (
                <aside class="mt-12 border-t-2 border-accent pt-7">
                  {blok.label && (
                    <p class="text-xs font-semibold uppercase tracking-[0.08em] text-accent">
                      {blok.label}
                    </p>
                  )}
                  <h2 class="mt-3 text-xl font-extrabold text-ink">{blok.kop}</h2>
                  <p class="mt-3 text-base text-ink-3">{blok.tekst}</p>
                  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
                    <a
                      href={hoofdactie.url}
                      class="rounded-base bg-accent px-7 py-4 text-center text-base font-semibold text-wit transition-colors hover:bg-accent-deep sm:py-3.5"
                    >
                      {hoofdactie.label}
                    </a>
                    <a
                      href={bedrijf.telefoonUrl}
                      class="rounded-base border border-line-strong px-7 py-4 text-center text-base font-medium text-ink-2 transition-colors hover:border-ink-3 sm:py-3.5"
                    >
                      {bedrijf.telefoon}
                    </a>
                  </div>
                </aside>
              );
            default:
              return (
                <p
                  class:list={[
                    "text-ink-3",
                    // De eerste alinea loopt door op de lead en mag groter.
                    i === 0
                      ? "text-[1.0625rem] leading-[1.6] text-ink-2 sm:text-lg sm:leading-[1.65]"
                      : "mt-4 text-base leading-[1.65] sm:mt-5 sm:text-[1.0625rem] sm:leading-[1.75]",
                  ]}
                  set:html={blok.tekst}
                />
              );
          }
        })
      }
      </div>
    </div>
  </Kader>

  <section class="border-t border-line bg-paper-2 py-11 lg:py-16">
    <Kader>
      <h2 class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">Verder lezen</h2>
      <ul class="mt-6 grid gap-x-10 gap-y-7 sm:grid-cols-3">
        {
          verder.map((ander) => (
            <li>
              <a href={`/nieuws/${ander.slug}/`} class="group block border-t border-line-strong pt-4">
                <p class="text-[0.6875rem] font-normal text-ink-4">{datumNL(ander.datum)}</p>
                <h3 class="mt-2 font-display text-base font-bold leading-snug tracking-tight text-ink group-hover:text-accent-deep">
                  {ander.h1}
                </h3>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-7">
        <a
          href="/nieuws/"
          class="text-base font-medium text-accent underline decoration-accent/30 underline-offset-2 transition-colors hover:decoration-current"
        >
          Alle artikelen
        </a>
      </p>
    </Kader>
  </section>

  <CtaBand />

  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />)}
</Base>
