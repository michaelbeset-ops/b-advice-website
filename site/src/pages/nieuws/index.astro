---
import Base from "../../layouts/Base.astro";
import Kader from "../../components/Kader.astro";
import Kruimels from "../../components/Kruimels.astro";
import Kop from "../../components/Kop.astro";
import Bovenregel from "../../components/Bovenregel.astro";
import CtaBand from "../../components/CtaBand.astro";
import { artikelen, nieuwsPagina } from "../../data/nieuws";
import { datumNL } from "../../lib/datum";

const [nieuwste, ...rest] = artikelen;

// Blog-blok met alle artikelen. Zo ziet Google het overzicht als één
// verzameling in plaats van als losse links.
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://b-advice.info/nieuws/#blog",
  name: nieuwsPagina.h1,
  description: nieuwsPagina.meta.omschrijving,
  inLanguage: "nl-NL",
  publisher: { "@id": "https://b-advice.info/#organisatie" },
  blogPost: artikelen.map((artikel) => ({
    "@type": "NewsArticle",
    headline: artikel.h1,
    description: artikel.samenvatting,
    datePublished: artikel.datum,
    url: `https://b-advice.info/nieuws/${artikel.slug}/`,
  })),
};

// Het jaar wordt alleen getoond zodra het wisselt. Dat geeft de lijst een
// ritme zonder dat er bij elk artikel een datum in beeld schreeuwt.
const metJaar = rest.map((artikel, i) => ({
  artikel,
  nieuwJaar: i === 0 || artikel.datum.slice(0, 4) !== rest[i - 1].datum.slice(0, 4),
}));
---

<Base titel={nieuwsPagina.meta.titel} omschrijving={nieuwsPagina.meta.omschrijving}>
  <Kader>
    <Kruimels spoor={[{ label: "Home", url: "/" }, { label: "Nieuws", url: "/nieuws/" }]} />
  </Kader>

  <Kader als="section" id="inhoud" klasse="pb-12 pt-10 lg:pt-14">
    <Bovenregel tekst="Nieuws" />
    <Kop
      als="h1"
      tekst={nieuwsPagina.h1}
      accent={nieuwsPagina.kopAccent}
      klasse="mt-6 max-w-[14ch] text-display font-extrabold text-ink"
    />
    <p class="mt-6 max-w-[50ch] text-xl font-medium text-ink-2">{nieuwsPagina.lead}</p>
  </Kader>

  <!-- Het nieuwste artikel op een donker vlak. Zonder foto's per artikel is
       dit het enige dat de pagina een duidelijk beginpunt geeft; daaronder
       gaat alles verder in gewone leesvolgorde. -->
  <section class="bg-ink">
    <Kader klasse="py-14 lg:py-16">
      <div class="grid gap-x-14 gap-y-7 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-merk">Net verschenen</p>
          <p class="mt-3 text-sm text-op-donker-sterk">
            {nieuwste.categorie} <span class="text-op-donker">·</span>
            <time datetime={nieuwste.datum}>{datumNL(nieuwste.datum)}</time>
          </p>
        </div>

        <div class="lg:col-span-9">
          <h2 class="max-w-[22ch] text-2xl font-extrabold text-wit">
            <a href={`/nieuws/${nieuwste.slug}/`} class="transition-colors hover:text-merk">
              {nieuwste.h1}
            </a>
          </h2>
          <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-op-donker-sterk">
            {nieuwste.samenvatting}
          </p>
          <a
            href={`/nieuws/${nieuwste.slug}/`}
            class="group mt-7 inline-flex items-center gap-2.5 text-base font-semibold text-merk"
          >
            Lees dit artikel
            <svg viewBox="0 0 24 16" class="h-3 w-5" aria-hidden="true">
              <path
                d="M0 8h21M15 1l7 7-7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="transition-transform group-hover:translate-x-1"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </Kader>
  </section>

  <!-- De rest als leeslijst in plaats van een raster met kaartjes: één regel
       per artikel, met de datum in een eigen kolom ernaast. Dat leest als een
       archief en niet als een sjabloon. -->
  <Kader als="section" klasse="pb-24 pt-16 lg:pb-28">
    <h2 class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">Eerder verschenen</h2>

    <ul class="mt-8 border-t border-line-strong">
      {
        metJaar.map(({ artikel, nieuwJaar }) => (
          <li>
            <a
              href={`/nieuws/${artikel.slug}/`}
              class="group grid gap-x-10 gap-y-2 border-b border-line py-7 transition-colors hover:bg-paper-2 lg:grid-cols-12 lg:py-8"
            >
              <p class="lg:col-span-3">
                <span class="text-xs font-semibold uppercase tracking-[0.08em] text-accent">
                  {artikel.categorie}
                </span>
                <span class="mt-1.5 block text-sm text-ink-4">
                  <time datetime={artikel.datum}>{datumNL(artikel.datum)}</time>
                </span>
              </p>

              <div class="lg:col-span-8">
                <h3 class="max-w-[40ch] font-display text-lg font-bold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent-deep lg:text-xl">
                  {artikel.h1}
                </h3>
                {/* De samenvatting blijft op een telefoon weg: twaalf regels
                    plus twaalf samenvattingen maakt de lijst twee keer zo
                    lang, terwijl de kop het onderwerp al vertelt. */}
                <p class="mt-2.5 hidden max-w-[68ch] text-sm leading-relaxed text-ink-3 sm:block">
                  {artikel.samenvatting}
                </p>
              </div>

              {/* Pijl alleen op brede schermen: op een telefoon is de hele
                  regel al aantikbaar en zou hij alleen ruimte kosten. */}
              <span aria-hidden="true" class="hidden lg:col-span-1 lg:flex lg:justify-end lg:pt-1">
                <svg viewBox="0 0 24 16" class="h-3 w-5 text-line-strong transition-all group-hover:translate-x-1 group-hover:text-accent">
                  <path d="M0 8h21M15 1l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Kader>

  <CtaBand />

  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} is:inline />
</Base>
