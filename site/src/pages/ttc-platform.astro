---
/**
 * Verborgen pagina over het platform van B-Advice x TTC.
 *
 * Deze pagina is alleen bereikbaar via de link en de QR-code op de flyer.
 * Daarom staat hij op noindex, hangt hij nergens in het menu, de footer of
 * het nieuwsoverzicht, en is hij in astro.config.mjs uit de sitemap gefilterd.
 * Let op, verborgen is niet beveiligd. Wie de link heeft, kan hem openen.
 *
 * Wie de QR scant, komt voor de video. Die staat daarom direct bovenaan.
 * De tekst eronder vult de flyer aan en herhaalt hem niet.
 *
 * Video toevoegen: zet het bestand in public/assets/ttc/ (mp4, H.264) en vul
 * hieronder bij `video` het pad in. Zolang dat leeg is, toont de pagina een
 * screenshot van het platform.
 */
import Base from "../layouts/Base.astro";
import Kader from "../components/Kader.astro";
import Veegrij from "../components/Veegrij.astro";
import Faq from "../components/Faq.astro";
import { hoofdactie } from "../data/site";

const video = ""; // bijvoorbeeld "/assets/ttc/demo.mp4"

const kerncijfers = [
  { waarde: "18 uur", tekst: "tijdwinst per locatie in ontwikkeling en voorbereiding" },
  { waarde: "1 tool", tekst: "voor de hele keten, van project tot beheer" },
  { waarde: "Alles", tekst: "wordt geregistreerd, dus volledige controle" },
];

const voorWie = [
  { titel: "Gemeenten", tekst: "Eén overzicht van alle containerlocaties, projecten, kosten en het beheer in de wijken." },
  { titel: "Afvalinzamelaars", tekst: "Meldingen, keuringen en wasrondes per container, met de historie erbij." },
  { titel: "Adviseurs en projectleiders", tekst: "Alle stukken per locatie bij elkaar, van locatieonderzoek tot oplevering." },
  { titel: "Aannemers, leveranciers en monteurs", tekst: "Alleen de locaties en taken waar zij aan werken, op telefoon of tablet." },
];

const niveaus = [
  { titel: "Lezen", tekst: "Locaties, containers en bestanden bekijken." },
  { titel: "Veld", tekst: "QR-codes scannen, keuringen invullen en meldingen maken met foto's." },
  { titel: "Project", tekst: "Locaties en containers bijwerken, bestanden en opmerkingen toevoegen." },
  { titel: "Beheer", tekst: "Kosten, budgetten, facturen, rapportages en de planning." },
];

const stappen = [
  { titel: "Kennismaken", tekst: "We laten het platform zien aan de hand van uw eigen situatie." },
  { titel: "Inrichten", tekst: "B-Advice zet uw gemeente, wijken en locaties klaar en zet bestaande gegevens over." },
  { titel: "Aan de slag", tekst: "Iedere gebruiker krijgt een eigen account met precies de rechten die hij nodig heeft." },
];

const vragen = [
  { vraag: "Werkt het platform ook op een telefoon?", antwoord: "Ja. Op kantoor werkt u op de pc, in het veld op telefoon of tablet. U kunt het platform op uw telefoon ook als app op het beginscherm zetten." },
  { vraag: "Kunnen we onze bestaande gegevens overzetten?", antwoord: "Ja. Bestaande locaties, containers en bestanden zetten we bij de start voor u in het platform." },
  { vraag: "Wie kan onze gegevens zien?", antwoord: "Alleen de mensen die de beheerder toegang geeft. Per gebruiker bepaalt u welke gemeentes en onderdelen zichtbaar zijn, van meldingen tot financiële rapporten." },
  { vraag: "Is te zien wie wat heeft gedaan?", antwoord: "Ja. Elke wijziging wordt vastgelegd, zodat u altijd kunt nagaan wie wat heeft gedaan en wanneer." },
  { vraag: "Hoe vragen we een demo aan?", antwoord: "Neem contact op met B-Advice via info@b-advice.info of +31 (6) 431 25 245. We plannen dan een demo in." },
];
---

<Base
  titel="B-Advice x TTC: platform voor ondergrondse containers"
  omschrijving="Het platform van B-Advice x TTC voor ondergrondse containers. De hele keten in één tool, van containerproject tot beheer en onderhoud."
  nietIndexeren
>
  <Kader als="section" id="inhoud" klasse="pt-10 lg:pt-14">
    <div class="flex items-center gap-4 sm:gap-5">
      <img src="/assets/b-advice-logo.webp" alt="B-Advice" width="137" height="40" loading="eager" class="h-10 w-auto sm:h-12" />
      <span class="font-display text-2xl font-bold text-ink-4" aria-label="en">×</span>
      <img src="/assets/ttc/ttc-logo.svg" alt="TTC Nederland" width="116" height="67" loading="eager" class="h-11 w-auto sm:h-13" />
    </div>
    <h1 class="mt-8 max-w-[24ch] text-3xl font-extrabold text-ink">Bekijk in de video hoe het platform werkt</h1>
    <p class="mt-4 max-w-[56ch] text-lg font-medium text-ink-2">
      De hele keten in één tool, van containerproject tot beheer en onderhoud.
    </p>
  </Kader>

  <Kader klasse="mt-8">
    {
      video ? (
        <video
          src={video}
          poster="/assets/ttc/platform-bord.webp"
          controls
          playsinline
          preload="metadata"
          class="w-full rounded-kaart border border-line bg-paper-2"
        />
      ) : (
        <img
          src="/assets/ttc/platform-bord.webp"
          alt="Projectbord in het platform met locaties per wijk"
          width="1385"
          height="689"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full rounded-kaart border border-line"
        />
      )
    }
  </Kader>

  <Kader klasse="mt-8">
    <ul class="grid gap-px overflow-hidden rounded-kaart border border-line bg-line sm:grid-cols-3">
      {
        kerncijfers.map((k) => (
          <li class="bg-paper-2 px-6 py-6">
            <span class="block font-display text-3xl font-extrabold text-accent">{k.waarde}</span>
            <span class="mt-1 block text-sm text-ink-3">{k.tekst}</span>
          </li>
        ))
      }
    </ul>
  </Kader>

  <section class="py-20 lg:py-24">
    <Kader>
      <p class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">Voor wie</p>
      <h2 class="mt-4 max-w-[28ch] text-2xl font-extrabold text-ink">Iedereen in de keten werkt in hetzelfde overzicht</h2>
      <ul class="mt-10 grid gap-x-12 gap-y-8 sm:grid-cols-2">
        {
          voorWie.map((f) => (
            <li class="border-t border-line pt-5">
              <h3 class="font-display text-lg font-bold tracking-tight text-ink">{f.titel}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-3">{f.tekst}</p>
            </li>
          ))
        }
      </ul>
    </Kader>
  </section>

  <section class="bg-ink text-op-donker">
    <Kader klasse="py-20 lg:py-24">
      <p class="text-xs font-semibold uppercase tracking-[0.1em] text-merk">Toegang</p>
      <h2 class="mt-4 max-w-[28ch] text-2xl font-extrabold text-wit">U bepaalt wie wat ziet en doet</h2>
      <p class="mt-5 max-w-[60ch] text-base text-op-donker-sterk">
        Informatie is alleen zichtbaar als de beheerder dat wil. Per gebruiker kiest u welke gemeentes zichtbaar zijn en wat iemand mag doen. Elk niveau bevat alles van het niveau ervoor.
      </p>
      <ol class="mt-12 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          niveaus.map((n, i) => (
            <li class="border-t border-wit/15 pt-5">
              <span class="font-display text-sm font-bold text-merk">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-2 font-display text-lg font-bold tracking-tight text-wit">{n.titel}</h3>
              <p class="mt-2 text-sm leading-relaxed text-op-donker-sterk">{n.tekst}</p>
            </li>
          ))
        }
      </ol>
    </Kader>
  </section>

  <section class="py-20 lg:py-24">
    <Kader>
      <p class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">Starten</p>
      <h2 class="mt-4 max-w-[28ch] text-2xl font-extrabold text-ink">In drie stappen aan de slag</h2>
    </Kader>

    <Veegrij als="ol" label="In drie stappen aan de slag" klasse="mt-10">
      {
        stappen.map((stap, i) => (
          <li class="w-[78vw] max-w-[20rem] shrink-0 snap-start border-t-2 border-accent/25 pt-5 sm:w-auto sm:max-w-none">
            <span class="font-display text-sm font-bold text-accent">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-2 font-display text-lg font-bold tracking-tight text-ink">{stap.titel}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-3">{stap.tekst}</p>
          </li>
        ))
      }
    </Veegrij>

    <Kader>
      <Faq vragen={vragen} />
    </Kader>
  </section>

  <section class="bg-accent">
    <Kader klasse="py-12 lg:py-20">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="max-w-[26ch] text-2xl font-extrabold text-wit">Benieuwd wat het platform voor uw gemeente doet?</h2>
          <p class="mt-3 max-w-[56ch] text-base text-wit/90">
            Neem contact op met B-Advice via <a href="mailto:info@b-advice.info" class="underline">info@b-advice.info</a> of <a href="tel:+31643125245" class="underline">+31 (6) 431 25 245</a>.
          </p>
        </div>
        <a href={hoofdactie.url} class="shrink-0 rounded-base bg-wit px-7 py-4 text-center text-base font-semibold text-accent transition-colors hover:bg-paper-2 sm:py-3.5">
          Vraag een demo aan
        </a>
      </div>
    </Kader>
  </section>
</Base>
