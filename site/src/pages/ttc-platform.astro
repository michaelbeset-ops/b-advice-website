---
/**
 * Verborgen pagina over het platform van B-Advice x TTC.
 *
 * Deze pagina is alleen bereikbaar via de link en de QR-code op de flyer.
 * Daarom staat hij op noindex, hangt hij nergens in het menu, de footer of
 * het nieuwsoverzicht, en is hij in astro.config.mjs uit de sitemap gefilterd.
 * Let op, verborgen is niet beveiligd. Wie de link heeft, kan hem openen.
 *
 * Wie de QR scant, wil de video zien. Die staat daarom op een telefoon als
 * eerste in beeld, en zo groot dat hij zonder scrollen op het scherm past.
 * Daaronder staat bewust maar weinig tekst. De rest staat op de flyer.
 *
 * Video vervangen: zet het nieuwe bestand in public/assets/ttc/ (mp4, H.264,
 * staand 9:16) en pas hieronder `video` en `poster` aan.
 */
import Base from "../layouts/Base.astro";
import Kader from "../components/Kader.astro";
import Kop from "../components/Kop.astro";
import { hoofdactie } from "../data/site";

const video = "/assets/ttc/ttc-verkoopspot.mp4";
const poster = "/assets/ttc/ttc-verkoopspot-poster.webp";

const kerncijfers = [
  { waarde: "18 uur", label: "tijdwinst per locatie in ontwikkeling en voorbereiding" },
  { waarde: "1 tool", label: "voor de hele keten, van project tot beheer" },
  { waarde: "Alles", label: "wordt geregistreerd, dus volledige controle" },
];

const punten = [
  "Alles op één plek, van gemeente tot container",
  "Kosten tot op locatieniveau inzichtelijk",
  "U bepaalt wie wat ziet",
  "Werkt op pc, telefoon en tablet",
];
---

<Base
  titel="B-Advice x TTC: platform voor ondergrondse containers"
  omschrijving="Het platform van B-Advice x TTC voor ondergrondse containers. De hele keten in één tool, van containerproject tot beheer en onderhoud."
  nietIndexeren
>
  <section class="bg-paper-2">
    <Kader als="div" id="inhoud" klasse="pt-5 pb-14 sm:pt-10 lg:pt-16 lg:pb-24">
      <div class="grid gap-y-8 lg:grid-cols-[1fr_22rem] lg:items-center lg:gap-x-20 xl:grid-cols-[1fr_24rem]">
        <!-- Video. Op een telefoon het eerste wat je ziet, en nooit hoger dan
             het scherm, zodat hij in één keer in beeld staat. -->
        <div class="lg:col-start-2 lg:row-start-1">
          <div class="mb-4 flex items-center justify-center gap-3 lg:hidden">
            <img src="/assets/b-advice-logo.webp" alt="B-Advice" width="137" height="40" loading="eager" class="h-7 w-auto" />
            <span class="font-display text-base font-bold text-ink-4" aria-hidden="true">×</span>
            <img src="/assets/ttc/ttc-logo.svg" alt="TTC Nederland" width="116" height="67" loading="eager" class="h-8 w-auto" />
          </div>
          <div class="mx-auto w-full max-w-[min(100%,calc(70svh*9/16))] lg:max-w-none">
            <div class="rounded-[1.75rem] bg-ink p-1.5 shadow-[0_24px_64px_rgb(18_33_26/0.22)] sm:p-2">
              <video
                src={video}
                poster={poster}
                controls
                playsinline
                preload="metadata"
                width="1080"
                height="1920"
                class="block aspect-[9/16] w-full rounded-[1.45rem] bg-ink object-cover"
              >
                <a href={video}>Bekijk de video</a>
              </video>
            </div>
          </div>
        </div>

        <div class="min-w-0 lg:col-start-1 lg:row-start-1">
          <div class="hidden items-center gap-4 rounded-kaart border border-line bg-wit px-5 py-3 lg:inline-flex">
            <img src="/assets/b-advice-logo.webp" alt="B-Advice" width="137" height="40" loading="eager" class="h-9 w-auto" />
            <span class="font-display text-xl font-bold text-ink-4" aria-hidden="true">×</span>
            <img src="/assets/ttc/ttc-logo.svg" alt="TTC Nederland" width="116" height="67" loading="eager" class="h-10 w-auto" />
          </div>
          <Kop
            als="h1"
            tekst="De hele keten in één tool"
            accent="één tool"
            klasse="max-w-[14ch] text-2xl font-extrabold text-ink lg:mt-8 lg:text-3xl xl:text-display"
          />
          <p class="mt-4 max-w-[44ch] text-lg font-medium text-ink-2">
            Van containerproject tot beheer en onderhoud. Gemeente, adviseur, aannemer en monteur werken in hetzelfde overzicht.
          </p>

          <dl class="mt-8 grid gap-y-5 border-t border-line pt-6 sm:grid-cols-3 sm:gap-x-6">
            {
              kerncijfers.map((k, i) => (
                <div class:list={[i > 0 && "sm:border-l sm:border-line sm:pl-6"]}>
                  <dd class="font-display text-2xl font-extrabold tracking-tight text-ink">{k.waarde}</dd>
                  <dt class="mt-1 max-w-[26ch] text-sm leading-snug text-ink-4">{k.label}</dt>
                </div>
              ))
            }
          </dl>

          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {
              punten.map((punt) => (
                <li class="flex items-start gap-3 text-base text-ink-2">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/10">
                    <svg viewBox="0 0 12 12" class="h-2.5 w-2.5 text-accent" aria-hidden="true">
                      <polyline points="2,6 5,9 10,3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  {punt}
                </li>
              ))
            }
          </ul>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              href={hoofdactie.url}
              class="rounded-base bg-accent px-7 py-4 text-center text-base font-semibold text-wit transition-colors hover:bg-accent-deep sm:py-3.5"
            >
              Vraag een demo aan
            </a>
            <a
              href="tel:+31643125245"
              class="rounded-base border border-line-strong px-7 py-4 text-center text-base font-medium text-ink-2 transition-colors hover:border-ink-3 sm:py-3.5"
            >
              Bel +31 (6) 431 25 245
            </a>
          </div>
        </div>
      </div>
    </Kader>
  </section>
</Base>
