---
import Base from "../layouts/Base.astro";
import Kader from "../components/Kader.astro";
import Kruimels from "../components/Kruimels.astro";
import Kop from "../components/Kop.astro";
import Bovenregel from "../components/Bovenregel.astro";
import CtaBand from "../components/CtaBand.astro";
import { projectenPagina, hoofdactie } from "../data/site";
---

<Base titel={projectenPagina.meta.titel} omschrijving={projectenPagina.meta.omschrijving}>
  <Kader>
    <Kruimels spoor={[{ label: "Home", url: "/" }, { label: "Projecten", url: "/projecten/" }]} />
  </Kader>

  <Kader als="section" id="inhoud" klasse="pt-10 lg:pt-14">
    <Bovenregel tekst="Projecten" />
    <Kop
      als="h1"
      tekst={projectenPagina.h1}
      accent={projectenPagina.kopAccent}
      klasse="mt-6 max-w-[16ch] text-display font-extrabold text-ink"
    />
    <p class="mt-6 max-w-[54ch] text-xl font-medium text-ink-2">{projectenPagina.lead}</p>
  </Kader>

  <!-- Er zijn nog geen referentieprojecten vrijgegeven. Liever dit eerlijke
       lege vlak dan verzonnen voorbeelden of een pagina die doet alsof er
       iets staat. -->
  <Kader als="section" klasse="pb-24 pt-12 lg:pb-28">
    <div class="max-w-[52ch] border-l-2 border-accent bg-paper-2 px-7 py-8">
      <h2 class="font-display text-lg font-bold tracking-tight text-ink">
        {projectenPagina.leegKop}
      </h2>
      <p class="mt-3 text-base text-ink-3">{projectenPagina.leegTekst}</p>
      <a
        href={hoofdactie.url}
        class="mt-6 inline-block rounded-base bg-accent px-7 py-3.5 text-base font-semibold text-wit transition-colors hover:bg-accent-deep"
      >
        {hoofdactie.label}
      </a>
    </div>
  </Kader>

  <CtaBand />
</Base>
