---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Diensten from "../components/Diensten.astro";
import Werkwijze from "../components/Werkwijze.astro";
import Platform from "../components/Platform.astro";
import Laatste from "../components/Laatste.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import Kader from "../components/Kader.astro";
import { home } from "../data/site";
---

<Base titel={home.meta.titel} omschrijving={home.meta.omschrijving}>
  <Hero />
  <Diensten />
  <Werkwijze />
  <Platform />
  <Laatste />
  <Kader klasse="pb-6">
    <Faq vragen={home.faq} />
  </Kader>
  <CtaBand />
</Base>
