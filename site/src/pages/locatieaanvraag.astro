---
import Base from "../layouts/Base.astro";
import Kader from "../components/Kader.astro";
import Kruimels from "../components/Kruimels.astro";
import Kop from "../components/Kop.astro";
import Bovenregel from "../components/Bovenregel.astro";
import LocatieFormulier from "../components/LocatieFormulier.vue";
import { locatieaanvraag, contact, bedrijf } from "../data/site";

// Een aanvraagformulier is voor Google een contactpagina. De stappen eronder
// zijn een HowTo: wat er gebeurt nadat iemand het formulier verstuurt.
const aanvraagSchema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": "https://b-advice.info/locatieaanvraag/#pagina",
    name: locatieaanvraag.h1,
    description: locatieaanvraag.meta.omschrijving,
    inLanguage: "nl-NL",
    mainEntity: { "@id": "https://b-advice.info/#organisatie" },
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Een locatie indienen bij B-Advice",
    description: locatieaanvraag.lead,
    step: locatieaanvraag.stappen.map((stap, i) => ({
      "@type": "HowToStep",
      position: i + 1,
      name: stap.titel,
      text: stap.tekst,
    })),
  },
];
---

<Base titel={locatieaanvraag.meta.titel} omschrijving={locatieaanvraag.meta.omschrijving}>
  <Kader>
    <Kruimels
      spoor={[{ label: "Home", url: "/" }, { label: "Locatieaanvraag", url: "/locatieaanvraag/" }]}
    />
  </Kader>

  <Kader als="section" id="inhoud" klasse="pt-10 lg:pt-14">
    <Bovenregel tekst="Aanvraag" />
    <Kop
      als="h1"
      tekst={locatieaanvraag.h1}
      accent={locatieaanvraag.kopAccent}
      klasse="mt-6 text-display font-extrabold text-ink"
    />
    <p class="mt-6 max-w-[52ch] text-xl font-medium text-ink-2">{locatieaanvraag.lead}</p>
  </Kader>

  <Kader klasse="pb-24 pt-12 lg:pb-28">
    <div class="grid gap-x-16 gap-y-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <LocatieFormulier
          client:load
          toegangssleutel={contact.web3formsSleutel}
          onderdelen={locatieaanvraag.onderdelen}
          bevestiging={locatieaanvraag.bevestiging}
          privacyUrl="/privacy/"
          email={bedrijf.email}
          telefoon={bedrijf.telefoon}
        />
      </div>

      <aside class="lg:col-span-4 lg:col-start-9">
        <h2 class="text-xs font-semibold uppercase tracking-[0.1em] text-accent">Hoe het werkt</h2>
        <ol class="mt-5 space-y-5">
          {
            locatieaanvraag.stappen.map((stap, i) => (
              <li class="flex gap-4">
                <span class="mt-0.5 font-display text-sm font-bold text-accent">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>
                  <span class="block font-display text-base font-bold tracking-tight text-ink">
                    {stap.titel}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-ink-3">{stap.tekst}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <div class="mt-10 border-t border-line-strong pt-6">
          <h2 class="font-display text-base font-bold tracking-tight text-ink">Liever even bellen?</h2>
          <p class="mt-2 text-sm text-ink-3">
            Een korte toelichting op de locatie scheelt vaak een ronde heen en weer.
          </p>
          <a
            href={bedrijf.telefoonUrl}
            class="mt-3 inline-block text-base font-semibold text-accent underline decoration-accent/30 underline-offset-2 transition-colors hover:decoration-current"
          >
            {bedrijf.telefoon}
          </a>
        </div>

        <div class="mt-10 border-t border-line-strong pt-6">
          <h2 class="font-display text-base font-bold tracking-tight text-ink">
            {locatieaanvraag.meten.kop}
          </h2>
          <p class="mt-2 text-sm text-ink-3">{locatieaanvraag.meten.tekst}</p>
          <a
            href={locatieaanvraag.meten.link.url}
            class="mt-3 inline-block text-base font-medium text-accent underline decoration-accent/30 underline-offset-2 transition-colors hover:decoration-current"
          >
            {locatieaanvraag.meten.link.label}
          </a>
        </div>
      </aside>
    </div>
  </Kader>

  {aanvraagSchema.map((blok) => (
    <script type="application/ld+json" set:html={JSON.stringify(blok)} is:inline />
  ))}
</Base>
